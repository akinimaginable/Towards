meta {
  name: Geocode
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/geocode
  body: none
  auth: none
}

params:query {
  text: Bruxelles-Central
  language: fr,nl
  types: STOP
  ~modes: RAIL,TRANSIT
  bias: 50.8453,4.3570
  limit: 10
}

headers {
  Accept: application/json
}

docs {
  **GET** `/api/v1/geocode`

  Autocomplete / geocode text to places and stops.
}
