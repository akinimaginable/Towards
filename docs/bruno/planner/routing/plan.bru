  ~preTransitRentalProviders: string
  ~preTransitRentalProviderGroups: string
  ~postTransitRentalProviders: string
  ~postTransitRentalProviderGroups: string
  ~ignoreDirectRentalReturnConstraints: false
  ~ignorePreTransitRentalReturnConstraints: false
  ~ignorePostTransitRentalReturnConstraints: false
  ~numItineraries: 5
  ~maxItineraries: 0
  ~pageCursor: string
  ~timetableView: true
  ~arriveBy: false
  ~searchWindow: 900
  ~requireBikeTransport: false
  ~requireCarTransport: false
  ~maxPreTransitTime: 900
  ~maxPostTransitTime: 900
  ~maxDirectTime: 1800
  ~fastestDirectFactor: 1.0
  ~timeout: 0
