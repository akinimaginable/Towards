TEAM_ID=

PRODUCT_NAME=Towards
PRODUCT_BUNDLE_IDENTIFIER=org.etrange.towards.Towards$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// MapLibre and Compose both ship HarfBuzz; Shared must link first or text glyphs break.
// See https://github.com/maplibre/maplibre-compose/issues/551 and CMP-8882
OTHER_LDFLAGS = -framework Shared -framework MapLibre $(inherited)