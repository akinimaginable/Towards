# Copy to .env and adjust as needed for local Docker Compose.
POSTGRES_DB=towards
POSTGRES_USER=towards
POSTGRES_PASSWORD=towards
POSTGRES_PORT=5432

BACKEND_PORT=8081
MOTIS_BASE_URL=https://api.transitous.org

# PostgreSQL is optional. Leave this false to run the backend without a database.
# To persist audit records, set DATABASE_ENABLED=true and COMPOSE_PROFILES=database.
DATABASE_ENABLED=false
# COMPOSE_PROFILES=database
DATABASE_POOL_SIZE=10
RATE_LIMIT_REQUESTS=120
