  ~luggage: 0
  ~slowDirect: false
  ~fastestSlowDirectFactor: 3.0
  ~withFares: false
  ~numLegAlternatives: 0
  ~withScheduledSkippedStops: false
  ~language: fr
  ~algorithm: PONG
