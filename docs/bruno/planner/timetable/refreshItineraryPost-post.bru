meta {
  name: Refresh Itinerary
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/itineraries/refresh
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "itineraryId": "{{itineraryId}}",
    "language": ["nl", "fr"]
  }
}

docs {
  **POST** `/api/v1/itineraries/refresh`

  Reconstruct an itinerary from an itinerary id returned by plan/trip.
}
