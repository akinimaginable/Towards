meta {
  name: One To Many Post (POST)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/one-to-many
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "one": "50.8458;4.3571",
    "many": [
      "50.8356;4.3364",
      "50.8467;4.3525"
    ],
    "mode": "WALK",
    "max": 1800,
    "maxMatchingDistance": 25,
    "arriveBy": false
  }
}

docs {
  **POST** `/api/v1/one-to-many`
  
  Street routing from one to many places or many to one.
  The order in the response array corresponds to the order of coordinates of the \`many\` parameter in the request body.
  
  operationId: oneToManyPost
}
