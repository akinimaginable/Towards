TEAM_ID=T9MBAJS7Z9
DEVELOPMENT_TEAM=$(TEAM_ID)

PRODUCT_NAME=Towards
PRODUCT_BUNDLE_IDENTIFIER=org.etrange.Towards

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=26.11.0

// MapLibre Native FFI needs libc++, zlib, and Apple graphics frameworks.
// https://maplibre.org/maplibre-compose/getting-started/
OTHER_LDFLAGS = -l"c++" -lz -framework Shared -framework CoreFoundation -framework CoreGraphics -framework CoreText -framework Foundation -framework ImageIO -framework Metal -framework QuartzCore $(inherited)