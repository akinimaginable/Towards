  ~transferTimeFactor: 1.0
  ~maxMatchingDistance: 25
  ~pedestrianProfile: FOOT
  ~pedestrianSpeed: 1.0
  ~cyclingSpeed: 1.0
  ~elevationCosts: NONE
  ~useRoutedTransfers: false
  ~detailedTransfers: false
  ~detailedLegs: true
  ~joinInterlinedLegs: true
  ~transitModes: TRANSIT
  ~directModes: WALK
  ~preTransitModes: WALK
  ~postTransitModes: WALK
  ~directRentalFormFactors: BICYCLE
  ~preTransitRentalFormFactors: BICYCLE
  ~postTransitRentalFormFactors: BICYCLE
  ~directRentalPropulsionTypes: HUMAN
  ~preTransitRentalPropulsionTypes: HUMAN
  ~postTransitRentalPropulsionTypes: HUMAN
  ~directRentalProviders: string
