meta {
  name: One To Many
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/one-to-many
  body: none
  auth: none
}

params:query {
  one: 50.8458;4.3571
  many: 50.8356;4.3364,50.8467;4.3525
  mode: WALK
  max: 1800
  maxMatchingDistance: 25
  ~elevationCosts: NONE
  arriveBy: false
  ~withDistance: false
}

headers {
  Accept: application/json
}

docs {
  **GET** `/api/v1/one-to-many`
  
  Street routing from one to many places or many to one.
  The order in the response array corresponds to the order of coordinates of the \`many\` parameter in the query.
  
  operationId: oneToMany
}
