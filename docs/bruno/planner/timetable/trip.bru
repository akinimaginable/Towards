meta {
  name: Trip
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/trips/{{tripId}}
  body: none
  auth: none
}

params:query {
  ~withScheduledSkippedStops: false
  ~language: nl,fr
}

headers {
  Accept: application/json
}

docs {
  **GET** `/api/v1/trips/{tripId}`

  Get a trip as an itinerary.
}
